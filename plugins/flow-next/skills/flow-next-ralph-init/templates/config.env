# Ralph config (edit as needed)

# Optional run-scope file: JSON with {"specs":[...]} (or legacy {"epics":[...]}).
# Empty = scan all open specs. Canonical fn-43.9 knob.
SPECS_FILE=

# Optional spec list (space or comma separated). Convenience alternative to
# SPECS_FILE: ralph.sh writes this list into $RUN_DIR/run.json automatically.
# Used only when SPECS_FILE is empty. Legacy EPICS= is also accepted for
# back-compat with pre-1.0 user configs.
SPECS=

# Plan gate
REQUIRE_PLAN_REVIEW=0
# PLAN_REVIEW: bare backend or full spec.
#   Bare: rp (macOS), codex, copilot, cursor, claude, none
#   Spec: backend[:model[:effort]] — e.g. codex:<model>:xhigh, copilot:<model>:xhigh,
#         cursor:<model> (cursor takes model only — no :effort), claude:<model>:<effort>
# The bare-backend name is extracted via ${PLAN_REVIEW%%:*} for gating; the full
# spec flows through FLOW_REVIEW_BACKEND to flowctl which resolves model + effort.
PLAN_REVIEW={{PLAN_REVIEW}}

# Work gate
# WORK_REVIEW: bare backend or full spec (same grammar as PLAN_REVIEW).
#   e.g. WORK_REVIEW=codex:<model>:xhigh   or   WORK_REVIEW=copilot:<model>   or   WORK_REVIEW=cursor:<model>
WORK_REVIEW={{WORK_REVIEW}}

# Spec completion gate (runs when all tasks done, before spec closes)
# COMPLETION_REVIEW: bare backend or full spec (same grammar).
#   e.g. COMPLETION_REVIEW=codex:<model>:xhigh   or   COMPLETION_REVIEW=copilot:<model>   or   COMPLETION_REVIEW=cursor:<model>
COMPLETION_REVIEW={{COMPLETION_REVIEW}}

# Codex sandbox mode (only used when PLAN_REVIEW or WORK_REVIEW is codex)
# Options: auto, read-only, workspace-write, danger-full-access
# auto: danger-full-access on Windows (sandbox blocks reads), read-only on Unix
CODEX_SANDBOX=auto

# Copilot runtime config (only used when PLAN/WORK/COMPLETION_REVIEW resolves to copilot).
# These env vars fill MISSING fields only — a full spec (e.g. WORK_REVIEW=copilot:<model>:xhigh
# or --spec copilot:<model>:xhigh) always wins. Receipts stamp model,
# effort, and spec fields so reviews are reproducible.
# Copilot serves both the OpenAI and Claude families; ask `copilot --help` or your
# org policy for the list this install actually exposes rather than trusting the
# value below.
# Default set 2026-09-05, when Copilot began serving GPT-6 Astra.
FLOW_COPILOT_MODEL=gpt-6-astra
# Effort: low | medium | high (default) | xhigh
FLOW_COPILOT_EFFORT=high

# Cursor runtime config (only used when PLAN/WORK/COMPLETION_REVIEW resolves to cursor).
# Runs the cursor-agent CLI, billed to your Cursor subscription. This env var fills
# the MISSING model only — a full spec (e.g. WORK_REVIEW=cursor:<model> or
# --spec cursor:<model>) always wins. Cursor bakes reasoning effort into the
# model name, so there is NO effort field (no cursor:<model>:<effort>, no FLOW_CURSOR_EFFORT).
# Ask `cursor-agent --list-models` for the current set. Cursor is not receiving
# GPT-6 Astra or later OpenAI models, and the OpenAI contract winds down on
# 2026-11-12, so pin a non-OpenAI model here when this backend is your only
# cross-family reviewer. Default set 2026-09-05.
FLOW_CURSOR_MODEL=gpt-5.6-sol-high

# Claude runtime config (only used when PLAN/WORK/COMPLETION_REVIEW resolves to claude).
# Runs the Claude Code CLI headless (claude -p), read-only. These env vars fill
# MISSING fields only — a full spec (e.g. WORK_REVIEW=claude:<model>:high) always
# wins; unset, flowctl's registry ranking and default effort (high) apply.
# Effort: low | medium | high | xhigh | max. Same-family when Ralph drives Claude Code.
#FLOW_CLAUDE_MODEL=
#FLOW_CLAUDE_EFFORT=high

# Work settings
BRANCH_MODE=new
MAX_ITERATIONS=25
# MAX_TURNS=  # optional; empty = no limit (Claude stops via promise tags)
MAX_ATTEMPTS_PER_TASK=5
# MAX_REVIEW_ITERATIONS=8  # fix+re-review cycles within one impl-review before giving up (default 8)
# WORKER_TIMEOUT=3600  # seconds; default 1hr. Safety guard against runaway workers, not primary flow control

# YOLO uses --dangerously-skip-permissions (required for unattended runs)
YOLO=1

# UI settings
# RALPH_UI=0  # set to 0 to disable colored output

# Optional Claude flags (only used if set)
# Default model: inherits from Claude Code (Fable 5.1 as of 2026-09-05). Only set to override.
# FLOW_RALPH_CLAUDE_MODEL=claude-fable-5-1   # id current 2026-09-05
# FLOW_RALPH_CLAUDE_SESSION_ID=
# FLOW_RALPH_CLAUDE_PERMISSION_MODE=bypassPermissions
# FLOW_RALPH_CLAUDE_NO_SESSION_PERSISTENCE=0
# FLOW_RALPH_CLAUDE_DEBUG=hooks
# FLOW_RALPH_CLAUDE_VERBOSE=1
# FLOW_RALPH_CLAUDE_PLUGIN_DIR=  # Use local dev plugin instead of cached (for testing)

# Watch mode (command-line flags, not env vars):
#   --watch          Show tool calls in real-time (logs still captured)
#   --watch verbose  Show tool calls + model responses (logs still captured)
# Example: ./ralph.sh --watch
